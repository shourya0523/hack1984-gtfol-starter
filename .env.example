# Model the app talks to. Defaults to Ollama on your laptop, which Vercel can't reach.
# Checkpoint 3 swaps these for Groq in Vercel > Settings > Environment Variables.
BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL=qwen2.5:7b

# Checkpoint 2: Vercel adds this when you connect Neon. `vercel env pull .env.local` brings it down.
# DATABASE_URL=postgres://...
